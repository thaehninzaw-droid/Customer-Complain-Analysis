# Copy this file to .env and fill in.
# Leave MONGODB_URI empty to run locally with the in-memory fallback -
# good enough for development and testing before Atlas is set up.

MONGODB_URI=
MONGODB_DB_NAME=complaints_db

# --- Demo admin account (see app/admin_seed.py) ---
# Seeded automatically every time the API starts if it doesn't exist
# yet. Change the password before this ever runs anywhere but your own
# machine - the default below is a placeholder, not a real secret.
ADMIN_EMAIL=admin@loopline.io
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=ChangeMe123!

# --- RAG chatbot: Gemini (LLM + embeddings) ---
# Get a key from https://aistudio.google.com/apikey
# Leave empty to run with the template-based chatbot fallback instead
# (no error, just less helpful answers) - see app/chatbot.py.
GEMINI_API_KEY=
# "gemini-flash-latest" is a Google-maintained alias that always
# points at the current GA Flash model - no manual bumping needed.
# Override with a pinned version (e.g. gemini-3.5-flash) if you want
# reproducible behavior instead.
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# --- RAG chatbot: Qdrant (vector store) ---
# Leave empty to run with the in-memory brute-force fallback instead
# (fine for the current small knowledge base - see app/rag/vector_store.py).
# Get a free cluster at https://cloud.qdrant.io, or run locally with:
#   docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=loopline_sop_chunks
