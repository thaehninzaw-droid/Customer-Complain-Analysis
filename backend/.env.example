# Copy this file to .env and fill in your values.
# Leave MONGODB_URI empty to use the in-memory fallback (fine for dev/testing).

MONGODB_URI=
MONGODB_DB_NAME=complaints_db

# --- Demo admin account ---
# Seeded automatically on first startup. Change before any real deployment.
ADMIN_EMAIL=admin@loopline.io
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=ChangeMe123!

# --- AI Chatbot: Groq (recommended — fast, geo-accessible, generous free tier) ---
# Get a free key at https://console.groq.com
# Set this and the chatbot works out of the box, including in Myanmar.
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- AI Chatbot: Gemini (fallback — used only when GROQ_API_KEY is not set) ---
# Get a key at https://aistudio.google.com/apikey
# Note: generativelanguage.googleapis.com is geo-blocked in some countries
# (including Myanmar). Use GROQ_API_KEY instead if you're in those regions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# --- Qdrant vector store (optional — for hybrid semantic retrieval) ---
# Leave empty to rely on BM25 keyword retrieval only (works great).
# Get a free cluster at https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=loopline_sop_chunks
